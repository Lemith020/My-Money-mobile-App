<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_quick_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ACTIONS"
            android:textColor="#7A7A90"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- 1. Add Expense -->
            <LinearLayout
                android:id="@+id/action_add_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_green"
                    android:padding="13dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#10B981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add Expense"
                    android:textColor="#4A4A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 2. Expenses -->
            <LinearLayout
                android:id="@+id/action_expenses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_purple"
                    android:padding="13dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#6D5DF6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Expenses"
                    android:textColor="#4A4A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 3. Summary -->
            <LinearLayout
                android:id="@+id/action_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_blue"
                    android:padding="13dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#3B82F6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Summary"
                    android:textColor="#4A4A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 4. Categories -->
            <LinearLayout
                android:id="@+id/action_categories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_yellow"
                    android:padding="13dp"
                    android:src="@android:drawable/ic_menu_report_image"
                    app:tint="#F59E0B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Categories"
                    android:textColor="#4A4A6A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>